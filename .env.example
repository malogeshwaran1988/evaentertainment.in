# SMTP (required in production for the contact form).
# Google Workspace / Gmail: smtp.gmail.com:465 with an App Password (not the account login password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@lasmind.com
CONTACT_TO=
# Careers applications (management). Falls back to CONTACT_TO when empty.
CAREERS_TO=

# Optional rate limits
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=60000

# Set to 1 to accept form posts without SMTP (local smoke tests only)
# 1 = never send: log + (dev) write previews to MAIL_PREVIEW_DIR, even if SMTP_* is set. Never 1 in production.
MAIL_MOCK=0
MAIL_PREVIEW_DIR=
# Local dev/builds use the disk store (storage/, public/images) even with BLOB_READ_WRITE_TOKEN set.
# Set 1 only to deliberately test against the real Blob store (spends the Hobby operation quota).
BLOB_USE_REMOTE=0

# Google Tag Manager container ID override; defaults to GTM-WRZW2JSM (loads in production builds only).
# Must be set before `next build`: NEXT_PUBLIC_ values are baked into the browser code at build time.
NEXT_PUBLIC_GTM_ID=

# Admin panel login (/login): Google sign-in via Auth.js (src/auth.ts).
# Random secret that encrypts the session cookie: `npx auth secret` or `openssl rand -base64 33`.
AUTH_SECRET=
# Google Cloud > APIs & Services > Credentials > OAuth client (Web application) for EVA.
# Redirect URIs: http://localhost:3000/api/auth/callback/google and
# https://evaentertainment.in/api/auth/callback/google (www redirects to the apex, so not needed).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated admin emails; every one must be @lasmind.com. Defaults to info@lasmind.com.
ADMIN_ALLOWED_EMAILS=info@lasmind.com
# Site origin for Auth.js. Not needed on Vercel (detected) or `next dev`; set it for
# `next start` / other hosts, e.g. AUTH_URL=http://localhost:3000
AUTH_URL=

# Vercel Blob store for the project list and posters. Set automatically by Vercel when the
# Blob store is connected; leave empty locally to save to disk instead.
BLOB_READ_WRITE_TOKEN=
# Cloudflare R2 bucket for the project list, blog and images (S3 API). All four keys are needed
# on Vercel; leave empty locally to save to disk instead. R2_PUBLIC_URL is the bucket's custom
# domain (e.g. https://media.example.com), only needed if images are served straight from R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Blob folder for EVA's data; defaults to eva/ (live). When testing locally with the real
# token, set eva-test/ so live projects and posters are never touched.
EVA_BLOB_PREFIX=

# Folder for projects.json when Blob isn't used (local dev). Defaults to ./storage.
EVA_DATA_DIR=

# --- Security hardening (security-hardening branch) ---
# Cloudflare Turnstile (forms). If unset, CAPTCHA is skipped and honeypot/timing/rate limit still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for rate limits shared across Vercel instances (Vercel Marketplace > Upstash sets these;
# KV_REST_API_URL / KV_REST_API_TOKEN are also accepted). Unset = in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
