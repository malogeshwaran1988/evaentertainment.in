# SMTP (required in production for contact / booking forms)
SMTP_HOST=md-64.webhostbox.net
SMTP_PORT=465
SMTP_USER=info@evaentertainment.in
SMTP_PASS=
SMTP_FROM=info@evaentertainment.in
CONTACT_TO=info@evaentertainment.in

# Optional rate limits
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=60000

# Set to 1 to accept form posts without SMTP (local smoke tests only)
MAIL_MOCK=0

# Google Tag Manager container ID override; defaults to GTM-WRZW2JSM (loads in production builds only).
# Must be set before `next build`: NEXT_PUBLIC_ values are baked into the browser code at build time.
NEXT_PUBLIC_GTM_ID=

# Admin panel login (/login). Single hardcoded account; set real values on the server.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random 32+ char secret used to sign the admin session cookie (openssl rand -base64 48)
ADMIN_SESSION_SECRET=

# Vercel Blob store for the project list and posters. Set automatically by Vercel when the
# Blob store is connected; leave empty locally to save to disk instead.
BLOB_READ_WRITE_TOKEN=
# Blob folder for EVA's data; defaults to eva/ (live). When testing locally with the real
# token, set eva-test/ so live projects and posters are never touched.
EVA_BLOB_PREFIX=

# Folder for projects.json when Blob isn't used (local dev). Defaults to ./storage.
EVA_DATA_DIR=

# --- Security hardening (security-hardening branch) ---
# Admin password as a bcrypt hash (preferred over ADMIN_PASSWORD). Generate:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'YourStrongPassword'
# In a local .env file escape each $ as \$ (Next.js expands $VARS); paste as-is in the Vercel dashboard.
ADMIN_PASSWORD_HASH=
# Optional TOTP 2FA for /login (base32 secret; add to Google Authenticator / 1Password). Generate:
#   node -e "console.log(new (require('otpauth').Secret)({size:20}).base32)"
ADMIN_TOTP_SECRET=

# Cloudflare Turnstile (forms). If unset, CAPTCHA is skipped and honeypot/timing/rate limit still apply.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis for rate limits shared across Vercel instances (Vercel Marketplace > Upstash sets these;
# KV_REST_API_URL / KV_REST_API_TOKEN are also accepted). Unset = in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
